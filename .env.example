# DoruTJ — корневой .env.example (DTJ-426, SRS-NFR-054).
#
# Полный список переменных, реально читаемых Zod-схемами конфигурации (`ConfigModule.forRoot({
# validate })`) обоих Node-процессов монорепозитория — `apps/api/src/config/env.schema.ts` и
# `apps/worker/src/config/env.schema.ts`. Полнота и актуальность этого файла ОТНОСИТЕЛЬНО ЭТИХ
# ДВУХ СХЕМ проверяется автоматически: `pnpm env:check` (CI, job `typecheck-lint-arch`) — сверяет
# множество имён здесь с множеством ключей `envSchema.shape` обеих схем, расхождение в любую
# сторону = красный CI (`scripts/env-check.ts`).
#
# Группировка — по категориям `docs/spec/31-nfr-security-testing-devops.md`
# §«Реестр переменных окружения» (`SRS-NFR-053`), заголовки категорий дословно совпадают с
# заголовками таблиц спеки, где к категории относится хотя бы одна РЕАЛЬНО читаемая переменная.
#
# ASSUMPTION (DTJ-426, см. JSDoc `scripts/env-check.ts`): полный реестр `SRS-NFR-053` (~70
# переменных) шире того, что сегодня реально проходит через Zod-схему — часть переменных читается
# напрямую через `process.env.*` в обход `ConfigModule` (например `JWT_PRIVATE_KEY`, EP-01/
# DTJ-022), часть относится к ещё не реализованным в R1 подсистемам (S3, WebSocket, on-premise).
# Этот файл документирует и проверяет ТОЛЬКО фактический контракт `envSchema` — не весь реестр
# спеки целиком (см. отчёт о сдаче DTJ-426, «НАЙДЕННЫЕ ЧУЖИЕ ПРОБЛЕМЫ»).
#
# Значения ниже — dev-безопасные дефолты или `CHANGE_ME`-плейсхолдеры (AGENTS.md §13: НИКАКОЙ
# реальный секрет сюда не попадает). Реальный `.env` — в `.gitignore`.

# ======================================================================================
# Инфраструктура и рантайм
# ======================================================================================

# development | test | production
NODE_ENV=development

# HTTP-порт apps/api.
PORT=3000

# Служебный порт GET /health apps/worker (SRS-NFR-037).
WORKER_HEALTH_PORT=3001

# Строка подключения PostgreSQL (SRS-NFR-037: readiness делает SELECT 1). Прикладной пул apps/api
# ОБЯЗАН ходить под app_role (SRS-DB-030) — см. apps/api/.env.example для деталей роли.
DATABASE_URL=postgres://app_role:dorutj_dev_app_role_password@localhost:5432/dorutj

# Строка подключения Redis (SRS-NFR-037: readiness делает PING).
REDIS_URL=redis://localhost:6379

# ======================================================================================
# Аутентификация и токены
# ======================================================================================

# [DTJ-027, REQ-TG-1] Telegram TWA auth: максимальный возраст initData.auth_date, секунды.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# [DTJ-027] Telegram bot token нейтрального тенанта (R1). Опционален — отсутствие ENV даёт
# 503 telegram_bot_not_configured, не блокирует остальной старт процесса.
TELEGRAM_BOT_TOKEN_NEUTRAL=CHANGE_ME

# [DTJ-023, SRS-API-019] Rate-limit окна OTP-запросов.
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX_PER_10MIN=3
OTP_REQUEST_MAX_PER_DAY=10
OTP_REQUEST_MAX_PER_IP_PER_HOUR=20

# [DTJ-023] Префикс ключей rate-limit OTP в Redis (multi-tenant изоляция) — не из таблицы
# SRS-NFR-053 буквально, реализовано DTJ-023 как часть той же группы.
OTP_RATE_LIMIT_KEY_PREFIX=otp_rl

# [DTJ-024, SRS-API-022] Лимит неверных попыток verify на один otpRequestId.
OTP_VERIFY_MAX_ATTEMPTS=5

# [DTJ-023] Dev-режим MockSmsProviderAdapter: true — код OTP попадает в лог/E2E-ответ.
# false в production (SRS-API-021: сырой код не покидает стек).
MOCK_SMS_EXPOSE_CODE_IN_RESPONSE=false

# ======================================================================================
# Provider Pattern (Charter §3.3)
# ======================================================================================

# [DTJ-238, SRS-PAY-009] mock_bank | alif_mobi | dc_next — единственный переключатель
# PaymentProvider на уровне DI. R1-прод — только mock_bank (Charter DoD п.7).
PAYMENT_DRIVER=mock_bank

# [DTJ-238, SRS-PAY-005] HMAC-секрет мок-банка — заведомо непроизводственное значение
# (AGENTS.md §13). Используется ОБОИМИ процессами (apps/api верифицирует, apps/worker подписывает).
MOCK_BANK_WEBHOOK_SECRET=dev-only-mock-bank-webhook-secret-change-me

# [DTJ-238, SRS-PAY-004] Задержка (мс) авто-вебхука MockBankProvider. 0 — авто-оплата выключена.
MOCK_BANK_AUTO_PAY_DELAY_MS=2000

# [DTJ-239, SRS-PAY-006/007] Заготовки адаптеров Alif Mobi/DC Next (R3 включение, ASSUMPTION
# research 03). НЕ заполнять в R1 — переключение PAYMENT_DRIVER на эти значения в проде физически
# заблокировано tenant_settings.enabledPaymentMethods (payments.module.ts). Пустое значение —
# намеренно (не CHANGE_ME, т.к. эти адаптеры фактически не используются в R1).
ALIF_MOBI_API_BASE_URL=
ALIF_MOBI_API_TOKEN=
ALIF_MOBI_WEBHOOK_SECRET=
DC_NEXT_API_BASE_URL=
DC_NEXT_API_TOKEN=
DC_NEXT_WEBHOOK_SECRET=

BANK_INVOICE_VALIDITY_MINUTES=15

# [DTJ-250, SRS-PAY-033] Единственный переключатель BankPayoutTransferPort. R1 — только 'mock'.
PAYOUT_DRIVER=mock

# [DTJ-250, SRS-PAY-033] Задержка (мс) MockBankPayoutTransferProvider.transferBatch. 0 — немедленно.
MOCK_PAYOUT_DELAY_MS=0

# ======================================================================================
# Транспорт и безопасность
# ======================================================================================

# [SRS-API-065] CSV allowlist CORS. В development дополнительно ВСЕГДА разрешён http://localhost:*.
CORS_STATIC_ORIGINS=https://dorutj.com,https://admin.dorutj.com

# [SRS-API-067] Таймаут HTTP-соединения, мс (ASSUMPTION 30000).
REQUEST_TIMEOUT_MS=30000

# [DTJ-227, SRS-DOM-166] Таймаут createInvoice после commit транзакции группы.
PAYMENT_PROVIDER_TIMEOUT_MS=8000

# [DTJ-432, SRS-API-012/013] Глобальный rate-limit (@fastify/rate-limit + Redis).
RATE_LIMIT_ANON_PER_MIN=100
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_1C_BATCH_PER_MIN=20

# [DTJ-253/254/250, SRS-ORD-032..036] Общий секрет apps/worker -> POST /api/v1/internal/orders/:id/
# system-cancel, POST /api/v1/internal/payouts/transfer-batch. ОБЯЗАН совпадать между процессами.
# Плейсхолдер ниже заведомо непроизводственный.
INTERNAL_API_KEY=dev-only-internal-api-key-change-me

# [DTJ-238] Базовый URL apps/api для самоссылающегося вызова apps/worker -> apps/api (вебхуки,
# internal/system-cancel, internal/payouts/transfer-batch). Не из таблицы SRS-NFR-053 буквально —
# конвенция заведена DTJ-238 (см. env.schema.ts apps/worker).
API_INTERNAL_URL=http://localhost:3000

# ======================================================================================
# Наблюдаемость
# ======================================================================================

# trace | debug | info | warn | error | fatal. apps/api: дефолт info(prod)/debug(dev), если не
# задано явно. apps/worker: дефолт info.
LOG_LEVEL=debug

# [SRS-ADM-066] Горизонт хранения audit_log, лет.
AUDIT_LOG_RETENTION_YEARS=5

# [DTJ-377] Расписание/размер батча джобы очистки audit_log (apps/worker) — не из таблицы
# SRS-NFR-053 буквально (там только AUDIT_LOG_RETENTION_YEARS), реализовано как часть той же группы.
AUDIT_LOG_RETENTION_CRON=0 3 1 */3 *
AUDIT_LOG_RETENTION_BATCH_SIZE=1000

# Отдельная строка подключения для джобы очистки audit_log (apps/worker) — НЕ падает на
# DATABASE_URL молча (append-only журнал, случайный DELETE под app_role был бы небезопасен).
# Опционален — пусто, пока джоба явно не включена отдельной ролью.
AUDIT_RETENTION_DATABASE_URL=

# ======================================================================================
# Фоновые джобы apps/worker — расписания/лимиты, реализованные сверх исходного реестра
# SRS-NFR-053 (конкретные ENV этой группы заведены соответствующими тикетами EP-09/EP-13/EP-15,
# не переименовывают/не дублируют ничего из категорий выше)
# ======================================================================================

# [DTJ-185, SRS-CAT-075] Таймаут композитного SQL-запроса поиска (apps/api), мс.
SEARCH_QUERY_TIMEOUT_MS=2000

# [DTJ-224, SRS-ORD-005] TTL мягкого Redis-резерва корзины (apps/api), секунды.
CART_HOLD_TTL_SECONDS=900

# [DTJ-160, SRS-INV-014] Максимум строк в одном файле Excel/CSV-импорта остатков (apps/api).
EXCEL_IMPORT_MAX_ROWS=20000

# [DTJ-181, SRS-CAT-070] Горизонт хранения search_query_log (apps/worker), дни.
SEARCH_QUERY_LOG_RETENTION_DAYS=180

# [DTJ-224, SRS-ORD-005..009] Горизонты хранения брошенной корзины (apps/worker), дни.
CART_ABANDONED_TTL_DAYS=30
CART_ABANDONED_GUEST_TTL_DAYS=7

# [DTJ-247, SRS-PAY-013/042] Расписание/дедупликация EscrowReconciliationJob (apps/worker).
RECONCILIATION_CRON=0 3 * * *
RECONCILIATION_DEDUP_DAYS=7
RECONCILIATION_METRIC_EXPORT_ENABLED=false

# [DTJ-253, SRS-ORD-032] Расписание UnpaidOrderTimeoutJob (apps/worker).
UNPAID_ORDER_TIMEOUT_CRON=*/2 * * * *

# [DTJ-254, SRS-ORD-035] Расписание PickupSlaTimeoutJob (apps/worker).
PICKUP_SLA_TIMEOUT_CRON=*/2 * * * *

# [DTJ-280, SRS-ADM-076] Расписание/анти-дребезг эскалации SupportSlaMonitorJob (apps/worker).
SUPPORT_SLA_MONITOR_CRON=*/5 * * * *
SUPPORT_SLA_RE_ESCALATION_MINUTES=30

# [DTJ-250, SRS-PAY-033] Расписание/размер батча PayoutExecutionJob (apps/worker).
PAYOUT_EXECUTION_CRON=0 * * * *
PAYOUT_BATCH_SIZE=50

# [DTJ-249, SRS-PAY-030] Расписание PayoutSchedulerJob (apps/worker).
PAYOUT_SCHEDULER_CRON=0 * * * *

# [DTJ-251, SRS-PAY-036] Расписания CashCommissionAggregationJob (apps/worker).
CASH_COMMISSION_AGGREGATION_DAILY_CRON=30 0 * * *
CASH_COMMISSION_AGGREGATION_WEEKLY_ISSUE_CRON=50 23 * * 0

# [DTJ-252, SRS-DOM-161] Расписание/grace period BillingInvoiceOverdueJob (apps/worker).
BILLING_INVOICE_OVERDUE_CRON=0 1 * * *
BILLING_INVOICE_OVERDUE_GRACE_PERIOD_DAYS=3
