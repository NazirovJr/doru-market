# apps/worker — переменные окружения (валидация: src/config/env.schema.ts).
# Процесс завершается с ненулевым кодом на старте, если обязательные переменные не заданы/невалидны.

# Redis/BullMQ — обязателен, без него процесс не подключится к очереди (SRS-NFR-037).
REDIS_URL=redis://localhost:6379

# Postgres — обязателен. apps/worker только ЧИТАЕТ БД, миграциями не владеет (см. apps/api).
DATABASE_URL=postgres://dorutj:dorutj@localhost:5432/dorutj

# Служебный порт GET /health (SRS-NFR-037: apps/worker несёт свой health, проверяет Redis/BullMQ,
# не разделяет liveness/readiness как apps/api — воркер не обслуживает HTTP-трафик клиентов).
WORKER_HEALTH_PORT=3001

# Уровень логирования pino/Nest Logger: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info

# DTJ-181: горизонт хранения search_query_log (дни) для джобы prune-search-query-log.
# ASSUMPTION (SRS-CAT-070) — необязателен, дефолт 180.
SEARCH_QUERY_LOG_RETENTION_DAYS=180

# DTJ-238, SRS-PAY-005: ТОТ ЖЕ секрет, что apps/api MOCK_BANK_WEBHOOK_SECRET — MockBankAutoPayJob
# подписывает исходящий вебхук им же. Плейсхолдер ниже заведомо непроизводственный.
MOCK_BANK_WEBHOOK_SECRET=dev-only-mock-bank-webhook-secret-change-me

# DTJ-238: базовый URL apps/api для самоссылающегося вызова POST /api/v1/payments/webhook
# (ASSUMPTION — конвенции API_INTERNAL_URL в проекте раньше не было, заведена этим тикетом).
# ТАКЖЕ используется DTJ-253/254 (unpaid-order-timeout/pickup-sla-timeout -> internal/system-cancel).
API_INTERNAL_URL=http://localhost:3000

# DTJ-247, SRS-PAY-013/042: расписание/дедупликация EscrowReconciliationJob — необязательны,
# дефолты см. env.schema.ts (найдено отсутствующим в этом файле при ревью DTJ-253, добавлено).
# RECONCILIATION_CRON=0 3 * * *
# RECONCILIATION_DEDUP_DAYS=7
# RECONCILIATION_METRIC_EXPORT_ENABLED=false

# DTJ-253, SRS-ORD-032: расписание UnpaidOrderTimeoutJob — необязателен, дефолт см. env.schema.ts.
# UNPAID_ORDER_TIMEOUT_CRON=*/2 * * * *

# DTJ-254, SRS-ORD-035: расписание PickupSlaTimeoutJob — необязателен, дефолт см. env.schema.ts.
# PICKUP_SLA_TIMEOUT_CRON=*/2 * * * *

# DTJ-253/254: общий секрет apps/worker -> POST /api/v1/internal/orders/:id/system-cancel
# (apps/api InternalServiceGuard) — ТОТ ЖЕ приём, что MOCK_BANK_WEBHOOK_SECRET, ОБЯЗАН совпадать
# со значением apps/api INTERNAL_API_KEY. Плейсхолдер ниже заведомо непроизводственный.
INTERNAL_API_KEY=dev-only-internal-api-key-change-me
