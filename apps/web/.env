# Локальные значения по умолчанию для разработки и CI. НЕ СЕКРЕТЫ — только адрес локального API.
#
# Почему этот файл в репозитории: Definition of Product Done (docs/00-PROJECT-CHARTER.md §2)
# требует, чтобы `pnpm verify` и сборка были зелёными на чистом клоне без внешних ключей.
# При этом fail-fast в vite.config.ts сознательно сохранён: продовая сборка без явно заданного
# VITE_API_BASE_URL упадёт на этапе конфигурации, а не соберёт бандл, стучащийся в "undefined".
#
# Реальные окружения переопределяют значения обычными переменными среды — они имеют приоритет
# над этим файлом. Секреты класть СЮДА НЕЛЬЗЯ: для них есть .env.local (в .gitignore).
VITE_API_BASE_URL=http://localhost:3000

# DTJ-198 (EP-08, SRS-CAT-053): style.json self-hosted vector-tile сервера (infra/docker/tileserver,
# EP-19 — вне scope этого тикета). ОПЦИОНАЛЕН, в отличие от VITE_API_BASE_URL: сборка НЕ падает, если
# он не задан или tileserver недоступен — MapView.tsx показывает фолбэк «карта недоступна» (критерий
# приёмки 5), а не белый экран. Значение ниже — конвенция tileserver-gl по умолчанию, реального
# сервера на этот порт в репозитории пока нет (заводится инфраструктурным тикетом EP-19).
VITE_TILESERVER_URL=http://localhost:8080/styles/basic-preview/style.json
