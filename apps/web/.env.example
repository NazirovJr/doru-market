# Базовый URL API-бэкенда (apps/api). Обязателен — без него сборка/dev-сервер падают
# с понятной ошибкой (см. src/shared/config/env.ts и vite.config.ts).
VITE_API_BASE_URL=http://localhost:3000

# style.json self-hosted vector-tile сервера карты аптек (DTJ-198, infra/docker/tileserver — EP-19).
# ОПЦИОНАЛЕН: если не задан или недоступен, MapView.tsx показывает фолбэк, сборка не падает.
VITE_TILESERVER_URL=http://localhost:8080/styles/basic-preview/style.json
