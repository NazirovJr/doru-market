# apps/api/.env.example — DTJ-001, шаг 9.
# ВСЕ переменные ниже 1:1 соответствуют `apps/api/src/config/env.schema.ts` (DoD тикета:
# ни одна переменная не должна разойтись между этим файлом и Zod-схемой). Реальный `.env`
# — в `.gitignore`, сюда попадают только dev-безопасные дефолты/плейсхолдеры.

# development | test | production
NODE_ENV=development

PORT=3000

# Строка подключения PostgreSQL (SRS-NFR-037: readiness делает `SELECT 1`).
# Прикладной пул ОБЯЗАН ходить под `app_role` (SRS-DB-030): у неё нет UPDATE/DELETE на
# `escrow_ledger` — это и есть append-only финансового журнала (SRS-DB-024). Роль заводит
# миграция `0031_app_role_privileges.sql`. Роль `dorutj_migrator` — ТОЛЬКО для раннера
# миграций: она суперпользователь, а суперпользователь игнорирует REVOKE, то есть под ней
# гарантия не действует вовсе. Прежнее значение указывало на роль `dorutj`, которой в
# кластере не существует.
DATABASE_URL=postgres://app_role:dorutj_dev_app_role_password@localhost:5432/dorutj

# Строка подключения Redis (SRS-NFR-037: readiness делает `PING`).
REDIS_URL=redis://localhost:6379

# trace | debug | info | warn | error | fatal — если не задано: info в production, debug иначе.
LOG_LEVEL=debug

# SRS-API-065: CSV allowlist CORS. В development дополнительно ВСЕГДА разрешён http://localhost:*.
CORS_STATIC_ORIGINS=https://dorutj.com,https://admin.dorutj.com

# SRS-API-067: таймаут HTTP-соединения, мс (ASSUMPTION 30000).
REQUEST_TIMEOUT_MS=30000

# Тестовая БД для интеграционных тестов (vitest.integration.config.ts, AGENTS.md Ж13).
# Креды test/test — заведомо непроизводственные, роль/БД создаются
# infra/docker/postgres-init/01-test-database.sql. НЕ используется в приложении напрямую —
# только справочно для локальной настройки, тесты задают DATABASE_URL сами.
# DATABASE_URL=postgres://test:test@localhost:5432/dorutj_test

# DTJ-238, SRS-PAY-009: mock_bank | alif_mobi | dc_next — единственный переключатель
# PaymentProvider на уровне DI. R1-прод — только mock_bank (Charter DoD п.7).
PAYMENT_DRIVER=mock_bank

# DTJ-238, SRS-PAY-005: HMAC-секрет мок-банка — генерируется при первом запуске dev-окружения,
# плейсхолдер ниже ЗАВЕДОМО непроизводственный (правило 13 AGENTS.md).
MOCK_BANK_WEBHOOK_SECRET=dev-only-mock-bank-webhook-secret-change-me

# DTJ-238, SRS-PAY-004: задержка (мс) авто-вебхука MockBankProvider. 0 — выключает авто-оплату
# (заказ остаётся pending_payment до dev-эндпоинта /api/v1/dev/mock-bank/simulate-payment).
MOCK_BANK_AUTO_PAY_DELAY_MS=2000

# DTJ-239, SRS-PAY-006 (ASSUMPTION, research 03 — контракт НЕ подтверждён банками): заготовки
# адаптеров Alif Mobi/DC Next. НЕ заполнять в R1 — переключение PAYMENT_DRIVER на эти значения
# в проде физически заблокировано tenant_settings.enabledPaymentMethods (см. payments.module.ts).
# ALIF_MOBI_API_BASE_URL=
# ALIF_MOBI_API_TOKEN=
# ALIF_MOBI_WEBHOOK_SECRET=
# DC_NEXT_API_BASE_URL=
# DC_NEXT_API_TOKEN=
# DC_NEXT_WEBHOOK_SECRET=
BANK_INVOICE_VALIDITY_MINUTES=15

# DTJ-250, SRS-PAY-033: единственный переключатель BankPayoutTransferPort на уровне DI.
# R1 — только 'mock' (реальный банковский адаптер — R3, вне периметра).
PAYOUT_DRIVER=mock

# DTJ-250, SRS-PAY-033: задержка (мс) MockBankPayoutTransferProvider.transferBatch. 0 — немедленно.
MOCK_PAYOUT_DELAY_MS=0

# DTJ-253/254/250: общий секрет apps/worker -> POST /api/v1/internal/orders/:id/system-cancel,
# POST /api/v1/internal/payouts/transfer-batch (InternalServiceGuard/PaymentsInternalServiceGuard).
# Плейсхолдер ниже заведомо непроизводственный. Без значения маршрут отказывает ЛЮБОМУ запросу
# (безопасный дефолт для секрета).
INTERNAL_API_KEY=dev-only-internal-api-key-change-me
