# DoruTJ — TLS-терминация для прод-развёртывания (DTJ-412, SRS-NFR-051/052).
#
# ОТКЛЮЧЁН ПО УМОЛЧАНИЮ: расширение `.disabled` (не `.conf`) — `nginx.conf` подключает только
# `conf.d/*.conf`, поэтому этот файл НЕ загружается, пока его явно не переименуют в
# `01-tls.conf`. Причина: файл ссылается на сертификаты по фиксированному пути
# (`/etc/nginx/certs/live/default/...`), которых на «чистой машине» dev/staging нет — если бы
# этот блок грузился всегда, `nginx -t` падал бы при старте и ВЕСЬ стек не поднимался бы,
# что нарушает критерий приёмки №1 (`docker compose up -d` поднимает весь стек) и №2 (health
# по plain HTTP). `00-gateway.conf` (порт 80) полностью самодостаточен для dev/staging/CI/E2E.
#
# Порядок включения на реальном проде (ручной runbook, не часть этого тикета):
#   1. Разово: `certbot certonly --standalone -d <domain>` (или webroot через уже поднятый
#      `00-gateway.conf`, ACME-challenge location в нём уже есть) — получить первый сертификат.
#   2. `mv conf.d/01-tls.conf.disabled conf.d/01-tls.conf` (или смонтировать volume с уже
#      переименованным файлом в `docker-compose.prod.yml`).
#   3. `docker compose exec nginx nginx -s reload` — без пересборки образа.
#   4. Сервис `certbot` (`profiles: ["prod"]`) продлевает сертификат по cron внутри контейнера
#      и триггерит `nginx -s reload` (см. SRS-NFR-052 п.3 — автоматизация по
#      `TenantDomainAttachedEvent`, отдельный follow-up тикет).

server {
    listen 443 ssl http2 default_server;
    server_name ~^(?<tenant_host>.+)$;

    ssl_certificate     /etc/nginx/certs/live/default/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/default/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/v1/realtime {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location /api/v1/auth/otp/ {
        limit_req zone=auth_otp burst=5 nodelay;
        proxy_pass http://api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=anon_global burst=20 nodelay;
        proxy_pass http://api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Порт 80 НЕ переопределяется здесь намеренно: `00-gateway.conf` уже слушает `80
# default_server` и продолжает работать как есть (ACME-challenge + прямая проксировка) —
# два файла в conf.d/ не могут одновременно объявлять `listen 80 default_server` (Nginx
# откажется стартовать с «duplicate default server»). Принудительный HTTP→HTTPS редирект —
# отдельное решение по ужесточению (правка `00-gateway.conf` за EP-19), не обязательное
# условие «TLS работает»: prod-домен доступен по 443 сразу после переименования этого файла.
