# syntax=docker/dockerfile:1
#
# Один Dockerfile для apps/api, apps/worker и одноразового контейнера миграций (targets:
# runtime, runtime-worker, migrator). Контекст сборки — корень монорепозитория.
#
# node:22-slim, не alpine: нативный argon2 надёжнее на glibc. Компилятор нужен только в
# стадии deps на случай отсутствия prebuild; в runtime его нет.
#
# Новый пакет в pnpm-workspace (apps/*, packages/*, tests/*) требует строки COPY его package.json
# в стадии deps — frozen-lockfile сверяет манифесты всех участников workspace.

# pnpm 11.23 требует Node >=22.13, поэтому не 22.12.
ARG NODE_IMAGE=node:22.13.0-slim

FROM ${NODE_IMAGE} AS base
# npm вместо corepack: corepack из node 22.12 не знает актуальных ключей подписи npm-реестра
# ("Cannot find matching keyid") и не может скачать pnpm.
RUN npm install --global pnpm@11.23.0
WORKDIR /repo

FROM base AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/pharmacy/package.json apps/pharmacy/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/domain-kernel/package.json packages/domain-kernel/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/testing-kit/package.json packages/testing-kit/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY tests/e2e/package.json tests/e2e/package.json
COPY tests/invariants/package.json tests/invariants/package.json
COPY tests/security/package.json tests/security/package.json
RUN pnpm install --frozen-lockfile --filter '@dorutj/api...' --filter '@dorutj/worker...'

FROM deps AS build
COPY tsconfig.base.json tsconfig.json ./
COPY packages/contracts packages/contracts
COPY packages/domain-kernel packages/domain-kernel
COPY packages/i18n packages/i18n
COPY packages/testing-kit packages/testing-kit
COPY apps/api apps/api
COPY apps/worker apps/worker
RUN pnpm --filter '@dorutj/api...' --filter '@dorutj/worker...' run build

# pnpm deploy собирает самодостаточный node_modules без devDependencies; workspace-пакеты
# копируются в него готовыми (dist), симлинков на /repo в образе не остаётся.
FROM build AS deploy
RUN pnpm --filter @dorutj/api deploy --prod --legacy /out/api \
  && pnpm --filter @dorutj/worker deploy --prod --legacy /out/worker

# Сид запускается из исходников через tsx (нужны devDependencies, JSON данных и testing-kit),
# поэтому отдельный dev/e2e-таргет на базе build, а не рантайм.
FROM build AS seeder
WORKDIR /repo/apps/api
CMD ["pnpm", "run", "db:seed"]

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
RUN groupadd --system --gid 1001 dorutj \
  && useradd --system --uid 1001 --gid dorutj --home-dir /app --shell /usr/sbin/nologin dorutj
# Раскладка apps/api внутри /app повторяет репозиторий: translit-map.loader читает
# ../../packages/i18n/translit-map.json по относительному пути от dist.
WORKDIR /app/apps/api
COPY --from=build --chown=dorutj:dorutj /repo/packages/i18n/translit-map.json /app/packages/i18n/translit-map.json
COPY --from=deploy --chown=dorutj:dorutj /out/api/node_modules ./node_modules
COPY --from=deploy --chown=dorutj:dorutj /out/api/package.json ./package.json
COPY --from=build --chown=dorutj:dorutj /repo/apps/api/dist ./dist
COPY --from=build --chown=dorutj:dorutj /repo/apps/api/migrations ./migrations
USER dorutj
EXPOSE 3000
CMD ["node", "dist/main.js"]

# Миграции ходят под ролью мигратора (DDL), поэтому отдельный одноразовый контейнер, а не
# шаг старта api: api работает под app_role без прав DDL. Путь ./migrations — от WORKDIR.
FROM runtime AS migrator
ENTRYPOINT ["node", "dist/infrastructure/database/migrate.js"]
CMD []

FROM ${NODE_IMAGE} AS runtime-worker
ENV NODE_ENV=production
RUN groupadd --system --gid 1001 dorutj \
  && useradd --system --uid 1001 --gid dorutj --home-dir /app --shell /usr/sbin/nologin dorutj
WORKDIR /app
COPY --from=deploy --chown=dorutj:dorutj /out/worker/node_modules ./node_modules
COPY --from=deploy --chown=dorutj:dorutj /out/worker/package.json ./package.json
COPY --from=build --chown=dorutj:dorutj /repo/apps/worker/dist ./dist
USER dorutj
EXPOSE 3001
CMD ["node", "dist/main.js"]
