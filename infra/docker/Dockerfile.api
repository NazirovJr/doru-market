# syntax=docker/dockerfile:1
#
# DoruTJ — multi-stage образ для apps/api и apps/worker (DTJ-412, SRS-NFR-049).
# ОДИН Dockerfile для двух рантайм-процессов (api HTTP + worker BullMQ) и одноразового
# init-контейнера миграций — общий слой зависимостей строится один раз (кэшируется
# Docker-слоями), НЕ дублирует `pnpm install` в трёх образах.
#
# Обоснование node:22.23-slim (НЕ alpine): нативные аддоны (в первую очередь `argon2`,
# см. pnpm-workspace.yaml allowBuilds) исторически проблемны на musl libc alpine —
# либо не собираются вовсе, либо требуют дополнительных build-зависимостей и дают
# нестабильные бинарные артефакты между патч-версиями Node. `slim` (Debian-based) снимает
# этот риск за разумную цену (~70 МБ против ~40 МБ alpine). НЕ переключать на alpine
# «для экономии места» без повторной проверки совместимости argon2/pg на musl.
#
# Патч-версия не произвольная: pnpm 11.23.0 (пин `packageManager`) требует Node >= 22.13,
# а corepack в образах младше ~22.2x несёт протухшие ключи проверки подписи npm и падает на
# `corepack prepare` («Cannot find matching keyid»). На прежнем 22.12 сборка не проходила вовсе.
#
# Пути init-контейнеров выверены реальной сборкой (волна 6), а не зафиксированы «по контракту»:
#   - apps/api/migrations/                        — миграции (НЕ apps/api/drizzle, такого каталога нет)
#   - dist/infrastructure/database/migrate.js     — раннер миграций
#   - dist/db/seed/seed-catalog.run.js            — сид (entrypoint сервиса `seed` в compose)
# Прежние значения ссылались на apps/api/drizzle и dist/scripts/*-entrypoint.js — ни того,
# ни другого в репозитории не существовало никогда, образ `migrator` не собирался вовсе.

FROM node:22.23-slim AS base
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
WORKDIR /app

# ---- Полный набор зависимостей (вкл. devDependencies) — нужен для build и для migrator
#      (drizzle-kit — devDependency apps/api, но требуется внутри контейнера миграций) ----
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter=@dorutj/api... --filter=@dorutj/worker...

FROM deps AS build
COPY . .
RUN pnpm turbo run build --filter=@dorutj/api --filter=@dorutj/worker

# ---- Только production-зависимости — отдельный пере-инсталл, чтобы в runtime не попадали
#      devDependencies (drizzle-kit, vitest, tsx и т.д.) ----
FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prod --filter=@dorutj/api... --filter=@dorutj/worker...

# ---- Стадия для одноразовых init-контейнеров (migrate/seed в docker-compose.yml) ----
# node_modules берётся из `deps` (полный, включая drizzle-kit) — этот образ никогда не
# публикуется как продовый рантайм-процесс, поверхность атаки не критична так, как у `runtime`.
FROM base AS migrator
# WORKDIR — часть контракта, не косметика: migrate.js ищет миграции по ОТНОСИТЕЛЬНОМУ
# пути './migrations', то есть от рабочего каталога. Из /app он искал бы /app/migrations.
WORKDIR /app/apps/api
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/migrations ./migrations
# pnpm раскладывает зависимости ИЗОЛИРОВАННО: пакеты apps/api лежат не в
# /app/node_modules, а в /app/apps/api/node_modules — симлинками внутрь
# /app/node_modules/.pnpm. Workspace-пакеты — симлинки на /app/packages/*.
# Без всех трёх копий не разрешается ни один import (прежде копировалась только первая).
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build /app/packages /app/packages
ENTRYPOINT ["node", "dist/infrastructure/database/migrate.js"]

# ---- Продовый рантайм — БЕЗ dev-зависимостей, БЕЗ исходников TS, непривилегированный ----
# Общий базовый слой для api и worker: оба процесса используют один и тот же
# production node_modules (устанавливается один раз в `prod-deps`, переиспользуется через
# Docker-кэш слоёв), различаются только точкой входа в CMD финальных стадий ниже.
FROM node:22.23-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=node:node /app/apps/worker/dist ./apps/worker/dist
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=prod-deps --chown=node:node /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=prod-deps --chown=node:node /app/apps/worker/node_modules ./apps/worker/node_modules
# Workspace-пакеты: раскладка симлинков — из prod-deps (в build она ссылается на
# dev-зависимости, которых здесь нет), собранный код — из build.
COPY --from=prod-deps --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build --chown=node:node /app/packages/domain-kernel/dist ./packages/domain-kernel/dist
COPY --from=build --chown=node:node /app/packages/i18n/dist ./packages/i18n/dist
USER node
EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]

# ---- Рантайм apps/worker — наследует runtime (тот же node_modules), другой CMD/порт ----
FROM runtime AS runtime-worker
EXPOSE 3001
CMD ["node", "apps/worker/dist/main.js"]
